# ==========================================
# VORTEX MARKETS - ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` to GitHub.
# ==========================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- JWT (for httpOnly cookie sessions) ---
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-long-random-secret-string-here

# --- Admin JWT (separate secret for admin panel) ---
ADMIN_JWT_SECRET=another-super-long-random-secret-string-here

# --- App Config ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Vortex Markets

# --- Marzpay Payment Gateway (to be filled later) ---
MARZPAY_API_KEY=
MARZPAY_API_SECRET=
MARZPAY_BASE_URL=

# --- Telegram (for "Join Telegram" link) ---
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/your_channel
